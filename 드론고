                if (q.category === '인성학교생활') badgeColor = 'bg-emerald-100 text-emerald-800';

                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-4';
