        // Recorder Simulation & Real Web Audio Recording Logic
        let mediaRecorder;
        let audioChunks = [];
        let isRecording = false;
        let timerInterval;
        let secondsElapsed = 0;

        function toggleRecording() {
            if (!isRecording) {
                startRecording();
            } else {
                stopRecording();
            }
        }

        async function startRecording() {
            audioChunks = [];
            secondsElapsed = 0;
            document.getElementById('timer-display').innerText = "00:00";
            document.getElementById('audio-playback-container').classList.add('hidden');
            document.getElementById('feedback-section').classList.add('hidden');

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                
                mediaRecorder.ondataavailable = event => {
                    audioChunks.push(event.data);
                };

                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/mp3' });
                    const audioUrl = URL.createObjectURL(audioBlob);
                    const audioPlayback = document.getElementById('audio-playback');
                    audioPlayback.src = audioUrl;
                    document.getElementById('audio-playback-container').classList.remove('hidden');
                };

                mediaRecorder.start();
                isRecording = true;

                // UI updates
                document.getElementById('record-btn').classList.replace('bg-blue-600', 'bg-red-600');
                document.getElementById('record-btn').classList.replace('hover:bg-blue-700', 'hover:bg-red-700');
                document.getElementById('mic-icon').className = "fa-solid fa-stop";
                document.getElementById('mic-pulse').classList.remove('hidden');
                document.getElementById('record-status-text').innerText = "녹음 진행 중... 또박또박 답변하세요!";

                timerInterval = setInterval(() => {
                    secondsElapsed++;
                    let mins = Math.floor(secondsElapsed / 60).toString().padStart(2, '0');
                    let secs = (secondsElapsed % 60).toString().padStart(2, '0');
                    document.getElementById('timer-display').innerText = `${mins}:${secs}`;
                }, 1000);

            } catch (err) {
                isRecording = true;
                document.getElementById('record-btn').classList.replace('bg-blue-600', 'bg-red-600');
                document.getElementById('mic-icon').className = "fa-solid fa-stop";
                document.getElementById('mic-pulse').classList.remove('hidden');
                document.getElementById('record-status-text').innerText = "모의 녹음 진행 중 (시뮬레이션 모드)";
                timerInterval = setInterval(() => {
                    secondsElapsed++;
                    let mins = Math.floor(secondsElapsed / 60).toString().padStart(2, '0');
                    let secs = (secondsElapsed % 60).toString().padStart(2, '0');
                    document.getElementById('timer-display').innerText = `${mins}:${secs}`;
                }, 1000);
            }
        }

        function stopRecording() {
            isRecording = false;
            clearInterval(timerInterval);

            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
            } else {
                document.getElementById('audio-playback-container').classList.remove('hidden');
            }

            document.getElementById('record-btn').classList.replace('red-600', 'blue-600');
            document.getElementById('record-btn').className = "w-16 h-16 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center text-2xl shadow-lg transition transform hover:scale-105 relative z-10";
            document.getElementById('mic-icon').className = "fa-solid fa-microphone";
            document.getElementById('mic-pulse').classList.add('hidden');
            document.getElementById('record-status-text').innerText = "녹음 완료! 아래 버튼을 눌러 피드백을 확인하세요.";
        }

