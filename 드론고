            document.getElementById('feedback-improvement').innerText = "말의 속도가 조금 빠를 수 있으니 중요한 키워드(전기, 드론, 안전) 앞에서 잠시 숨을 고르며 여유를 가지면 더욱 좋습니다.";
            document.getElementById('feedback-script').innerText = q.modelAnswer;
            
            document.getElementById('score-badge').innerText = "예상 점수: 95점";
            document.getElementById('feedback-section').classList.remove('hidden');
            document.getElementById('feedback-section').scrollIntoView({ behavior: 'smooth' });
        }

        // Student Text Answer Analysis & Feedback Function
        function analyzeStudentText() {
            const userText = document.getElementById('student-answer-input').value.trim();
            const qId = document.getElementById('mock-q-select').value;
            const q = questionDatabase.find(item => item.id == qId);

            if (!userText) {
                showModal("입력 확인", "첨삭받을 답변 내용을 입력해 주세요.");
                return;
            }

            // Evaluation logic based on user input length and keywords
            let score = 88;
            let strength = "지원자의 진솔한 경험과 소신이 잘 담겨 있어 면접관에게 긍정적인 인상을 줍니다.";
            let improvement = "다소 구어체로 표현된 문장을 전문 기술인에게 어울리는 명확하고 신뢰감 주는 어조(~하겠습니다, ~목표입니다)로 다듬으면 훨씬 완성도가 높아집니다.";

            if (userText.length > 50) {
                score = 96;
                strength = "답변의 분량이 충분하며, 진로에 대한 구체적인 고민과 학교 교육과정에 대한 이해가 돋보입니다.";
                improvement = "현재 작성해주신 내용에 '구체적인 실습 경험'이나 '안전 의식' 키워드를 한 스푼 더 추가하면 100점짜리 답변이 됩니다.";
            } else {
                score = 82;
                strength = "핵심적인 의도가 간결하게 전달됩니다.";
                improvement = "답변이 다소 짧으므로, '왜 그런 생각을 하게 되었는지(이유)'와 '입학 후 포부'를 1~2문장 더 덧붙여 보세요.";
            }

            document.getElementById('feedback-strength').innerText = strength;
            document.getElementById('feedback-improvement').innerText = improvement;
            
            // Generate polished script blending user's core idea and model answer
            let polishedScript = `[작성해주신 답변의 맞춤형 업그레이드 버전]\n"${userText} 특히 경북드론고 전기과에서 체계적인 실무 교육을 받으며 ${q.modelAnswer.slice(0, 70)}..."`;
            document.getElementById('feedback-script').innerText = polishedScript;

            document.getElementById('score-badge').innerText = `AI 첨삭 점수: ${score}점`;
            document.getElementById('feedback-section').classList.remove('hidden');
            document.getElementById('feedback-section').scrollIntoView({ behavior: 'smooth' });
        }

        // Modal Helpers
        function showModal(title, desc) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-desc').innerText = desc;
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        // Initialize App on Load
        window.onload = function() {
            renderQuestions();
            populateMockDropdown();
        };
    </script>
</body>
