        // Tab Switching Logic
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('active', 'bg-white', 'text-blue-900', 'shadow');
                el.classList.add('text-white', 'hover:bg-white/10');
            });

            document.getElementById(`content-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.add('active', 'bg-white', 'text-blue-900', 'shadow');
            activeBtn.classList.remove('text-white', 'hover:bg-white/10');
        }

        // Render Questions (100 Questions with Filtering & Searching)
        function renderQuestions() {
            const container = document.getElementById('questions-container');
            container.innerHTML = '';

            const filterVal = document.getElementById('question-filter').value;
            const searchVal = document.getElementById('question-search').value.toLowerCase();

            let filtered = questionDatabase;
            if (filterVal !== 'all') {
                filtered = filtered.filter(q => q.category === filterVal);
            }
            if (searchVal.trim() !== '') {
                filtered = filtered.filter(q => q.title.toLowerCase().includes(searchVal) || q.hint.toLowerCase().includes(searchVal) || q.modelAnswer.toLowerCase().includes(searchVal));
            }

            document.getElementById('q-count').innerText = filtered.length;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="col-span-2 bg-white p-8 rounded-2xl text-center text-slate-500 border border-slate-200">
                        <i class="fa-solid fa-folder-open text-3xl mb-2 text-slate-300"></i>
