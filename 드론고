        function loadMockQuestion() {
            const selectId = document.getElementById('mock-q-select').value;
            const q = questionDatabase.find(item => item.id == selectId);
            if (q) {
                document.getElementById('mock-q-title').innerText = q.title;
                document.getElementById('mock-q-hint').innerText = q.hint;
                document.getElementById('mock-q-model-answer').innerText = q.modelAnswer;
                document.getElementById('student-answer-input').value = ""; // clear input
                document.getElementById('feedback-section').classList.add('hidden');
            }
        }

